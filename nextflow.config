manifest {
    name = "splice_sim"
    author = "Niko Popitsch, Tobias Neumann"
    version = "0.1"
    description = "splice-aware RNA simulator"
}

timeline {
    enabled = true
    file = "logs/execution_timeline.html"
}

profiles {
    slurm {
        process {
            beforeScript = ''
            module = ''
            executor = 'slurm'
            cpus = '8'
            memory = '64 GB'
            time = '8.h'
            scratch = false
            container = '/mnt/shared/scratch/dfreebur/PhD/rna_modifications/splice_sim/splice_sim_latest.sif'
            shell = 'bash'
            clusterOptions = {
                def opts = []
                opts << '--export=NONE'
                if (task.queue == 'g') {
                    opts << '--gres=gpu:1'
                }
                return opts.join(' ')
            }

            queue = {
                task.memory <= 32.GB ?
                    (task.time < 6.h ?
                        task.memory <= 2.GB ? 'hicpu' : 'short'
                        : task.time < 24.h ? 'medium' : 'long')
                    : 'himem'
            }
            clusterOptions = { task.queue == 'g' ? '--gres gpu:1' : '' }

            withName: 'build_model' {
                memory = '10 GB'
                cpus = 1
                time = '1.h'
            }

            withName: 'simulate_reads' {
                memory = '40 GB'
                cpus = 2
                time = '1.h'
            }

            withName: 'map_star' {
                memory = '40 GB'
                cpus = 2
                time = '6.h'
            }

            withName: 'map_hisat_3n' {
                memory = '40 GB'
                cpus = 10
                time = '6.h'
            }

            withName: 'map_merangs' {
                memory = '80 GB'
                cpus = 2
                time = '1.h'
            }

            withName: 'map_segemehl' {
                memory = '80 GB'
                cpus = 12
                time = '8.h'
            }

            withName: 'postprocess_bams' {
                memory = '100 MB'
                cpus = 1
                time = '1.h'
            }

            withName: 'evaluate_bams' {
                memory = '1 GB'
                cpus = 2
                time = '1.h'
            }

            withName: 'extract_feature_metadata' {
                memory = '1 GB'
                cpus = 1
                time = '1.h'
            }

            withName: 'preprocess_results' {
                memory = '1 GB'
                cpus = 1
                time = '1.h'
                container = 'oras://community.wave.seqera.io/library/r-base_r-data.table_r-dplyr_r-dtplyr_pruned:4ba09d83678c507b'
            }

            withLabel: 'highmem' {
                memory = '200 GB'
                cpus = 16
                time = '8.h'
            }

            withLabel: 'long' {
                memory = '200 GB'
                cpus = 16
                time = '4.d'
            }
        }

        singularity {
            enabled = true
            autoMounts = true
            cacheDir = '/mnt/shared/scratch/dfreebur/PhD/splice_sim/singularity_cache'
            runOptions = "-B /mnt/shared/scratch/dfreebur/PhD"
        }
    }
}

workflow.onComplete = {
    println "Completed at : $workflow.complete"
    println "Status       : ${workflow.success ? 'OK' : 'failed'}"
    println "Duration     : ${workflow.duration}"
    println "work dir     : ${workflow.workDir}"
    println "exit status  : ${workflow.exitStatus}"
    println "Error report : ${workflow.errorReport ?: '-'}"
    println "Command line : ${workflow.commandLine}"
}
